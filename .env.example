# ==============================================================================
# CONFIGURACIÓN DEL MICROSERVICIO DE HISTORIAS RRSS (TACOS BAR / DISCOTECA)
# ==============================================================================

# --- TELEGRAM BOT ---
# Token obtenido a través de @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# IDs de Telegram autorizados para enviar fotos (separados por comas)
ALLOWED_TELEGRAM_IDS=123456789,987654321

# --- SUPABASE ---
# URL de la instancia de Supabase (Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# Service Role Key (Project Settings > API > service_role secret).
# NECESARIO para gestionar y purgar archivos de Storage sin restricciones RLS del cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Nombre del bucket público en Supabase Storage
SUPABASE_BUCKET_NAME=social-media

# --- META GRAPH API (INSTAGRAM STORIES v21.0) ---
# ID de la cuenta de Instagram Business/Creator vinculada a la Fanpage
INSTAGRAM_ACCOUNT_ID=17841400000000000

# Token de acceso de larga duración (Page / User Access Token con permiso instagram_content_publish)
META_ACCESS_TOKEN=EAA...

# --- GOOGLE DRIVE BACKUP ---
# ID de la carpeta de destino en Google Drive donde se alojará el respaldo permanente
GOOGLE_DRIVE_FOLDER_ID=1A2B3C4D5E6F7G8H9I0JkLmNoPqRsTuVw

# Ruta relativa o absoluta al archivo de credenciales de Service Account de Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# --- SISTEMA & FECHAS ---
# Zona horaria del negocio para cálculos de fecha y cronjobs (Bogotá, Lima, Quito)
TIMEZONE=America/Bogota

# Puerto opcional para verificaciones de salud HTTP
PORT=3000
